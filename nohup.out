          (2): Conv2d(192, 384, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
          (3): ReLU(inplace=True)
          (4): Conv2d(384, 768, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
        )
