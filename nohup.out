        (fc_relu1): ReLU()
        (fc2): Linear(in_features=1024, out_features=1024, bias=True)
        (fc_relu2): ReLU()
      )
      (bbox_3D_dims): Linear(in_features=1024, out_features=3, bias=True)
      (bbox_3D_center_deltas): Linear(in_features=1024, out_features=2, bias=True)
      (bbox_3D_pose): Linear(in_features=1024, out_features=6, bias=True)
      (bbox_3D_center_depth): Linear(in_features=1024, out_features=1, bias=True)
      (bbox_3D_uncertainty): Linear(in_features=1024, out_features=1, bias=True)
    )
    (cube_pooler): ROIPooler(
